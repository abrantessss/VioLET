        Reference 1:
          Value: true
          Y Value: 0
          Tolerance: 0
          Label: Zero
          Color: 180; 180; 180
          Alpha: 0.65
          Line Width: 1
          Line Style: Dot
      Legend:
        Enabled: true
        Show Values: true
        Position: Top Right
        X Offset: 4
        Y Offset: 4
      Layout:
        Width: 570
        Height: 270
        X Offset: 10
        Y Offset: 10
        Horizontal Alignment: Center
        Vertical Alignment: Bottom
      Style:
        Background Color: 0; 0; 0
        Background Alpha: 0.74
        Axis Color: 230; 230; 230
        Grid Color: 130; 130; 130
